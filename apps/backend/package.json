{
  "name": "thunderledger-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/app.test.js",
    "db:generate": "drizzle-kit generate --config ../../drizzle.config.ts",
    "db:check": "drizzle-kit check --config ../../drizzle.config.ts"
    ,"db:migrate": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.1.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
